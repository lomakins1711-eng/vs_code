// Общий модуль УправлениеTCO, сервер, экспорт.

// Рассчитывает совокупную стоимость владения.
//
// Параметры:
//  ПараметрыРасчета - Структура:
//   * ДатаНачала - Дата - дата начала расчета.
//   * СтавкаДисконтирования - Число - годовая ставка, например 0.15 для 15%.
//   * УчитыватьДисконтирование - Булево - признак расчета приведенной стоимости.
//   * Затраты - ТаблицаЗначений - таблица затрат.
//
// Возвращаемое значение:
//  Структура - итоги расчета:
//   * Итого - Число - простая сумма затрат с учетом вероятности.
//   * ИтогоДисконтированное - Число - сумма с учетом дисконтирования.
//   * ПоСтатьям - Соответствие - итоги по статьям затрат.
//
Функция РассчитатьTCO(ПараметрыРасчета) Экспорт

	ПроверитьПараметрыРасчетаTCO(ПараметрыРасчета);

	ДатаНачала = ПараметрыРасчета.ДатаНачала;
	СтавкаДисконтирования = ПараметрыРасчета.СтавкаДисконтирования;
	УчитыватьДисконтирование = ПараметрыРасчета.УчитыватьДисконтирование;
	Затраты = ПараметрыРасчета.Затраты;

	Итого = 0;
	ИтогоДисконтированное = 0;
	ПоСтатьям = Новый Соответствие;

	Для Каждого СтрокаЗатрат Из Затраты Цикл

		Вероятность = ВероятностьЗатраты(СтрокаЗатрат);
		СуммаСУчетомВероятности = СтрокаЗатрат.Сумма * Вероятность;

		Итого = Итого + СуммаСУчетомВероятности;

		Если УчитыватьДисконтирование Тогда
			НомерПериода = НомерГодовогоПериода(ДатаНачала, СтрокаЗатрат.Период);
			СуммаДляИтога = ПриведеннаяСтоимость(СуммаСУчетомВероятности, СтавкаДисконтирования, НомерПериода);
		Иначе
			СуммаДляИтога = СуммаСУчетомВероятности;
		КонецЕсли;

		ИтогоДисконтированное = ИтогоДисконтированное + СуммаДляИтога;
		ДобавитьСуммуПоСтатье(ПоСтатьям, СтрокаЗатрат.Статья, СуммаДляИтога);

	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Итого", Итого);
	Результат.Вставить("ИтогоДисконтированное", ИтогоДисконтированное);
	Результат.Вставить("ПоСтатьям", ПоСтатьям);

	Возврат Результат;

КонецФункции

// Подготавливает демонстрационные данные для проверки расчета.
//
// Возвращаемое значение:
//  ТаблицаЗначений - пример затрат по проекту внедрения 1С.
//
Функция ПодготовитьПримерЗатратTCO() Экспорт

	Затраты = Новый ТаблицаЗначений;
	Затраты.Колонки.Добавить("Период");
	Затраты.Колонки.Добавить("Статья");
	Затраты.Колонки.Добавить("ВидЗатрат");
	Затраты.Колонки.Добавить("Сумма");
	Затраты.Колонки.Добавить("Вероятность");

	ДобавитьЗатратуTCO(Затраты, Дата(2026, 1, 1), "Лицензии 1С", "Приобретение", 450000, 1);
	ДобавитьЗатратуTCO(Затраты, Дата(2026, 2, 1), "Внедрение и настройки", "Внедрение", 900000, 1);
	ДобавитьЗатратуTCO(Затраты, Дата(2026, 3, 1), "Миграция данных", "Внедрение", 220000, 1);
	ДобавитьЗатратуTCO(Затраты, Дата(2026, 4, 1), "Обучение пользователей", "Внедрение", 180000, 1);
	ДобавитьЗатратуTCO(Затраты, Дата(2027, 1, 1), "Сопровождение за год", "Эксплуатация", 360000, 1);
	ДобавитьЗатратуTCO(Затраты, Дата(2028, 1, 1), "Сопровождение за год", "Эксплуатация", 390000, 1);
	ДобавитьЗатратуTCO(Затраты, Дата(2028, 6, 1), "Риск простоя", "Риск", 500000, 0.2);
	ДобавитьЗатратуTCO(Затраты, Дата(2029, 1, 1), "Архивирование старой системы", "Вывод", 120000, 1);

	Возврат Затраты;

КонецФункции

Процедура ДобавитьЗатратуTCO(Затраты, Период, Статья, ВидЗатрат, Сумма, Вероятность) Экспорт

	НоваяСтрока = Затраты.Добавить();
	НоваяСтрока.Период = Период;
	НоваяСтрока.Статья = Статья;
	НоваяСтрока.ВидЗатрат = ВидЗатрат;
	НоваяСтрока.Сумма = Сумма;
	НоваяСтрока.Вероятность = Вероятность;

КонецПроцедуры

Функция ПриведеннаяСтоимость(Сумма, СтавкаДисконтирования, НомерПериода)

	Если НомерПериода <= 0 Или СтавкаДисконтирования = 0 Тогда
		Возврат Сумма;
	КонецЕсли;

	Возврат Сумма / Pow(1 + СтавкаДисконтирования, НомерПериода);

КонецФункции

Функция НомерГодовогоПериода(ДатаНачала, ДатаЗатраты)

	Если ДатаЗатраты <= ДатаНачала Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Год(ДатаЗатраты) - Год(ДатаНачала);

КонецФункции

Функция ВероятностьЗатраты(СтрокаЗатрат)

	Если СтрокаЗатрат.Вероятность = Неопределено Тогда
		Возврат 1;
	КонецЕсли;

	Возврат СтрокаЗатрат.Вероятность;

КонецФункции

Процедура ДобавитьСуммуПоСтатье(ПоСтатьям, Статья, Сумма)

	Если ПоСтатьям.Получить(Статья) = Неопределено Тогда
		ПоСтатьям.Вставить(Статья, 0);
	КонецЕсли;

	ПоСтатьям.Вставить(Статья, ПоСтатьям.Получить(Статья) + Сумма);

КонецПроцедуры

Процедура ПроверитьПараметрыРасчетаTCO(ПараметрыРасчета)

	Если ПараметрыРасчета = Неопределено Тогда
		ВызватьИсключение "Не заполнены параметры расчета TCO.";
	КонецЕсли;

	Если Не ПараметрыРасчета.Свойство("ДатаНачала") Тогда
		ВызватьИсключение "В параметрах расчета TCO не заполнена дата начала.";
	КонецЕсли;

	Если Не ПараметрыРасчета.Свойство("СтавкаДисконтирования") Тогда
		ПараметрыРасчета.Вставить("СтавкаДисконтирования", 0);
	КонецЕсли;

	Если Не ПараметрыРасчета.Свойство("УчитыватьДисконтирование") Тогда
		ПараметрыРасчета.Вставить("УчитыватьДисконтирование", Ложь);
	КонецЕсли;

	Если Не ПараметрыРасчета.Свойство("Затраты") Тогда
		ВызватьИсключение "В параметрах расчета TCO не передана таблица затрат.";
	КонецЕсли;

КонецПроцедуры
